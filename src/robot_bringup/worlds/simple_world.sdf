<?xml version="1.0" ?>
<sdf version="1.9">
<world name="simple_world">

  <physics name="1ms" type="ignored">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>

  <plugin filename="gz-sim-physics-system"
    name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system"
    name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
    name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-contact-system"
    name="gz::sim::systems::Contact"/>
  <plugin filename="gz-sim-sensors-system"
    name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <!-- ===== LIGHTING ===== -->
  <light name="sun" type="directional">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.9 0.9 0.9 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>0 0 -1</direction>
  </light>

  <!-- ===== GROUND PLANE ===== -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>8 8</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1</mu><mu2>1</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>8 8</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ===== OUTER WALLS (8x8 m room) ===== -->

  <!-- South wall -->
  <model name="wall_south">
    <static>true</static>
    <pose>0 -4 1.0 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>8.0 0.2 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>8.0 0.2 2.0</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- North wall -->
  <model name="wall_north">
    <static>true</static>
    <pose>0 4 1.0 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>8.0 0.2 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>8.0 0.2 2.0</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- West wall -->
  <model name="wall_west">
    <static>true</static>
    <pose>-4 0 1.0 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>0.2 8.0 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.2 8.0 2.0</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- East wall -->
  <model name="wall_east">
    <static>true</static>
    <pose>4 0 1.0 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>0.2 8.0 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.2 8.0 2.0</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ===== OBSTACLES =====
       6 small obstacles arranged in a loose ring inside the 8x8 m room.
       Origin (0,0) kept clear for robot spawn.
       Each obstacle footprint <= 0.5 m radius.
       Min ~2.5 m between obstacle centres — wide corridors for the robot.
  -->

  <!-- 1. CUBE — north-west, red -->
  <model name="cube_NW">
    <static>true</static>
    <pose>-1.5 2.5 0.4 0 0 0.4</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>0.7 0.7 0.8</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.7 0.7 0.8</size></box></geometry>
        <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>1.0 0.3 0.3 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- 2. SPHERE — north-east, green -->
  <model name="sphere_NE">
    <static>true</static>
    <pose>1.5 2.5 0.4 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.5</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.5</radius></sphere></geometry>
        <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.3 0.9 0.3 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- 3. CONE — mid-east, orange -->
  <model name="cone_E">
    <static>true</static>
    <pose>2.0 -0.5 0.0 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cone><radius>0.5</radius><length>0.9</length></cone></geometry>
      </collision>
      <visual name="visual">
        <geometry><cone><radius>0.5</radius><length>0.9</length></cone></geometry>
        <material><ambient>0.9 0.4 0.0 1</ambient><diffuse>1.0 0.55 0.0 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- 4. CUBE — south-east, blue -->
  <model name="cube_SE">
    <static>true</static>
    <pose>1.0 -1.8 0.4 0 0 0.8</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>0.7 0.7 0.8</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.7 0.7 0.8</size></box></geometry>
        <material><ambient>0.2 0.2 0.9 1</ambient><diffuse>0.3 0.3 1.0 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- 5. SPHERE — south-west, yellow -->
  <model name="sphere_SW">
    <static>true</static>
    <pose>-2.0 -2.0 0.4 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.7</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.7</radius></sphere></geometry>
        <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>1.0 0.9 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- 6. CONE — mid-west, purple -->
  <model name="cone_W">
    <static>true</static>
    <pose>-2.0 0.2 0.0 0 0 0</pose>
    <link name="link">
      <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cone><radius>0.5</radius><length>0.9</length></cone></geometry>
      </collision>
      <visual name="visual">
        <geometry><cone><radius>0.5</radius><length>0.9</length></cone></geometry>
        <material><ambient>0.5 0.1 0.8 1</ambient><diffuse>0.7 0.2 1.0 1</diffuse></material>
      </visual>
    </link>
  </model>

</world>
</sdf>